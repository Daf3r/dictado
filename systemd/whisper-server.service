[Unit]
Description=whisper.cpp — local server for voice dictation
Documentation=https://github.com/ggml-org/whisper.cpp
After=graphical-session.target

[Service]
Type=simple
# Keeps the model (1.6 GB) resident in RAM. Without this, the first
# transcription after boot would pay the load from disk; with the server it is
# a steady ~440 ms on an RTX 4060 via Vulkan.
#
# ggml-small was used at first: faster (110 ms) but it confused similar-sounding
# words. large-v3-turbo gets them right and is still far faster than needed for
# dictation.
#
# Listens on 127.0.0.1 ONLY: the server exposes no authentication, so it must
# never be reachable from the network.
ExecStart=/usr/bin/whisper-server \
    --model %h/.local/share/whisper-models/ggml-large-v3-turbo.bin \
    --language en \
    --threads 8 \
    --host 127.0.0.1 \
    --port 8080

# Warm-up: the FIRST inference after start pays ~8 s compiling Vulkan shaders;
# subsequent ones are ~110 ms. It is triggered here with a silent wav so that
# cost is not paid by your first real dictation.
ExecStartPost=/bin/sh -c 'sleep 3; curl -s --max-time 90 \
    -F "file=@%h/.local/share/whisper-models/warmup.wav" \
    -F "language=en" -F "response_format=text" \
    http://127.0.0.1:8080/inference >/dev/null 2>&1 || true'

Restart=on-failure
RestartSec=3

# The Vulkan backend detects and uses the discrete GPU automatically.
# Adjust or remove if you have a different setup.
Environment=GGML_VK_VISIBLE_DEVICES=0

[Install]
WantedBy=default.target
